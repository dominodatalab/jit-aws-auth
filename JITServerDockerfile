ARG pythonversion=3.13
FROM cgr.dev/dominodatalab.com/python:${pythonversion}-dev AS build
COPY --chown=nonroot:nonroot jit-proxy-server/ /app/jit
RUN mkdir -p /app/jit/pi/metrics && chown nonroot:nonroot /app/jit/pi/metrics
WORKDIR /app/jit
RUN uv venv venv
ENV PATH="/app/jit/venv/bin:$PATH"
RUN uv pip install --no-cache-dir -r requirements.txt && rm requirements.txt
USER root
RUN mkdir /pi && chown nonroot:nonroot /pi

FROM cgr.dev/dominodatalab.com/python:${pythonversion}
ARG COMMITHASH
ARG RELEASEVER
ENV LOG_LEVEL=INFO
ENV PYTHONUNBUFFERED=true
ENV PORT=5000
ENV PYTHONPATH="/app"
ENV PATH="/app/jit/venv/bin:$PATH"
ENV COMMIT=$COMMITHASH
ENV RELEASE=$RELEASEVER
COPY --from=build --chown=nonroot:nonroot /app/jit /app/jit
WORKDIR /app
ENTRYPOINT ["gunicorn","--chdir","/app/jit","-c","/app/jit/gunicorn.conf.py","jit_server:create_app()"]